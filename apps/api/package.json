{
  "name": "@quotekai/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev":               "tsx watch src/index.ts",
    "build":             "tsc",
    "start":             "node dist/index.js",
    "typecheck":         "tsc --noEmit",
    "db:migrate:dev":    "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio":         "prisma studio",
    "db:seed":           "tsx prisma/seed.ts",
    "db:reset":          "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@quotekai/shared-types": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.0",
    "pino": "^9.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "pino-pretty": "^11.2.0",
    "prisma": "^5.20.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
